{
  "version": 3,
  "configurePresets": [
    {
      "name": "macos-default",
      "displayName": "macOS Clang + vcpkg",
      "description": "Локальна конфігурація для macOS arm64",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{HOME}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-default",
      "configurePreset": "macos-default"
    }
  ]
}